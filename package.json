    "configuration": {
      "title": "Fresh File Explorer",
      "properties": {
        "freshFileExplorer.timeWindows": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "default": [
            1,
            3,
            7,
            14,
            30,
            60,
            90,
            180
          ],
          "description": "List of day values for time window options (e.g. 14 = up to 14 days ago). 'Pending changes' is always available. Commit history up to your highest defined time window will be preloaded in the background to enable near instant switching between windows.",
          "order": 1
        },
        "freshFileExplorer.defaultGroupingMode": {
          "type": "string",
          "default": "File Structure",
          "enum": [
            "File Structure",
            "Flat List",
            "Author",
            "Commit Hash",
            "Moon Phase",
            "Retrograde"
          ],
          "enumDescriptions": [
            "Group by file/directory structure",
            "All files in a flat sorted list, no subdirectory nodes",
            "Group by commit author",
            "Group by commit",
            "Group by lunar phase at commit time",
            "Group by which planets were retrograde"
          ],
          "description": "Default grouping mode for new workspaces. Changing this resets any per-workspace override."
        },
        "freshFileExplorer.defaultSortOrder": {
          "type": "string",
          "default": "name",
          "enum": [
            "name",
            "date",
            "author"
          ],
          "enumDescriptions": [
            "Sort by filename",
            "Sort by most recent commit date",
            "Sort by commit author"
          ],
          "description": "Default sort order for new workspaces. Changing this resets any per-workspace override."
        },
        "freshFileExplorer.defaultOpenChangesMode": {
          "type": "boolean",
          "default": false,
          "description": "Default open-changes mode for new workspaces. When true, clicking a file opens its diff instead of the file itself. Changing this resets any per-workspace override."
        },
        "freshFileExplorer.autoExpandDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of directory levels to automatically expand when the tree is loaded (0 = collapsed, 1 = root expanded, etc.)"
        },
        "freshFileExplorer.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reveal and select the active editor's file in the Fresh Files tree when switching tabs."
        },
        "freshFileExplorer.flatList.labelStyle": {
          "type": "string",
          "default": "path",
          "enum": [
            "path",
            "filename"
          ],
          "enumDescriptions": [
            "Show the repo-relative file path as the label (e.g. src/utils/pathUtils.ts)",
            "Show only the filename as the label; the directory path is prepended to the description"
          ],
          "description": "Controls what is shown as the primary label for each file in Flat List grouping mode."
        },
        "freshFileExplorer.description.showDate": {
          "type": "boolean",
          "default": true,
          "description": "Show relative date in file description"
        },
        "freshFileExplorer.description.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Show commit author in file description"
        },
        "freshFileExplorer.description.showCommitHash": {
          "type": "boolean",
          "default": false,
          "description": "Show commit hash in file description"
        },
        "freshFileExplorer.description.showCommitMessage": {
          "type": "boolean",
          "default": true,
          "description": "Show commit message in file description"
        },
        "freshFileExplorer.description.showStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show file status (modified, added, etc.)"
        },
        "freshFileExplorer.description.showLineChanges": {
          "type": "boolean",
          "default": false,
          "description": "Show line additions/deletions (+/-) in file descriptions for pending changes."
        },
        "freshFileExplorer.showCurrentBranchSync": {
          "type": "boolean",
          "default": true,
          "description": "Show sync status warnings for current branch (indicating you need to push/pull)"
        },
        "freshFileExplorer.showBaseBranchSync": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings when base branch has commits not in current branch (indicating you need to merge)"
        },
        "freshFileExplorer.codeTelescopeIntegration": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, Fresh File Explorer will use Code Telescope instead of its own quick pick (CTRL+Q, F) to quickly search Fresh Files. Requires the Code Telescope extension (guichina.code-telescope)."
        },
        "freshFileExplorer.autoStageRename": {
          "type": "boolean",
          "default": true,
          "description": "Use git mv for renames so the rename is auto-staged. When disabled, uses a plain filesystem rename which shows as delete + add in git."
        },
        "freshFileExplorer.heatmap.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Color files by recency (heatmap). Recent files appear bright (cyan/blue), older files faded (gray). Colors appear in all views (Explorer, tabs, Fresh Files tree)."
        },
        "freshFileExplorer.blameHeatmap.autoApply": {
          "type": "boolean",
          "default": true,
          "description": "Automatically apply the last used blame heatmap mode (Absolute Age or Branch Changes) when you open or switch to a new editor tab. The branch ref selected during the last manual toggle is reused, so you won't be prompted again. Performance note — Absolute Age runs git blame on every new file (~100ms–2s depending on file size and history depth); Branch Changes adds a merge-base lookup and a branch commit-range query on top of that (~50–150ms extra, dominated by blame). This will not slow down tab opening, but may take a short while for the heatmap to show up."
        },
        "freshFileExplorer.blameHeatmap.backgroundOpacity": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of the per-line background color wash applied by the blame heatmap (0 = invisible, 1 = fully opaque). The gutter bar is unaffected. Recommended values are low (0.05-0.15)"
        },
        "freshFileExplorer.blameHeatmap.maxFileLines": {
          "type": "number",
          "default": 1500,
          "minimum": 100,
          "description": "Skip the blame heatmap for files with more lines than this limit. git blame on large files can be slow; raise this if you regularly work with bigger files and find the performance acceptable."
        },
        "freshFileExplorer.incrementalTreeLoading": {
          "type": "boolean",
          "default": false,
          "description": "Update the fresh file tree progressively, adding data for each configured time window as it becomes available. When disabled, updates fire when repositories are found, when pending changes are ready, and when your selected time window is ready."
        },
        "freshFileExplorer.gitTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Timeout in seconds for git operations. I consider it suspicious if you ever need to increase this number. Please open an issue."
        },
        "freshFileExplorer.openSearchInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open searches in a Search Editor tab instead of the Search view"
        },
        "freshFileExplorer.searchPatternMaxLength": {
          "type": "number",
          "default": 4000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum length for search include pattern per batch. When exceeded, files are split into multiple search editor tabs. This affects features 'search in fresh files' and 'search in found files' in cases where the search covers a large number of files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run compile:webview",
    "clean": "rimraf out",
    "compile": "npm run clean && tsc -p ./ && npm run copy:fixtures",
    "compile:webview": "tsc -p src/webview/tsconfig.json --noEmit && esbuild src/webview/gitLogLPanel.ts src/webview/diffSearchPanel.ts src/webview/perfBenchmarkPanel.ts src/webview/stonksPanel.ts --bundle --outdir=media --format=iife --platform=browser",
    "copy:fixtures": "copyfiles -u 1 \"src/test/fixtures/**\" out/",
    "watch": "npm run copy:fixtures && run-p watch:ext watch:webview",
    "watch:ext": "tsc -watch -p ./",
    "watch:webview": "esbuild src/webview/gitLogLPanel.ts src/webview/diffSearchPanel.ts src/webview/perfBenchmarkPanel.ts src/webview/stonksPanel.ts --bundle --outdir=media --format=iife --platform=browser --watch",
    "pretest": "npm run compile && npm run compile:webview && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:coverage": "vscode-test --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.105.1",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.3"
  }
}