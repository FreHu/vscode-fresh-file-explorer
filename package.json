{
  "name": "fresh-file-explorer",
  "displayName": "Fresh File Explorer",
  "description": "A vscode file explorer which shows only recently modified files based on a combination of Git history and your pending changes",
  "license": "MIT",
  "pricing": "Free",
  "publisher": "frehu",
  "sponsor": {
    "url": "https://github.com/sponsors/FreHu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FreHu/vscode-fresh-file-explorer"
  },
  "version": "1.1.1",
  "icon": "icons/extension.png",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "freshFileExplorer",
          "name": "Fresh Files",
          "type": "tree",
          "icon": "icons/fresh-files.svg",
          "contextualTitle": "Fresh File Explorer"
        },
        {
          "id": "diffSearchResults",
          "name": "Diff Search Results",
          "type": "tree",
          "icon": "$(git-compare)",
          "contextualTitle": "Diff Search Results",
          "when": "diffSearchResults.hasResults"
        }
      ]
    },
    "commands": [
      {
        "command": "freshFileExplorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "freshFileExplorer.setTimeWindow",
        "title": "Set Time Window",
        "icon": "$(calendar)"
      },
      {
        "command": "freshFileExplorer.viewOptions",
        "title": "View Options",
        "icon": "$(filter)"
      },
      {
        "command": "freshFileExplorer.setGroupingMode",
        "title": "Set Grouping Mode",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "freshFileExplorer.setSortOrder",
        "title": "Set Sort Order",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "freshFileExplorer.showOutput",
        "title": "Fresh Files: Show Output Log"
      },
      {
        "command": "freshFileExplorer.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "freshFileExplorer.expandSubtree",
        "title": "Expand Subtree"
      },
      {
        "command": "freshFileExplorer.revealInExplorer",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "freshFileExplorer.openFile",
        "title": "Open"
      },
      {
        "command": "freshFileExplorer.openChanges",
        "title": "Open Changes"
      },
      {
        "command": "freshFileExplorer.openCommit",
        "title": "Open Commit"
      },
      {
        "command": "freshFileExplorer.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "freshFileExplorer.toggleOpenMode",
        "title": "Toggle left click action between Open File / Compare with previous",
        "icon": "$(file)"
      },
      {
        "command": "freshFileExplorer.exhume",
        "title": "View Deleted File",
        "icon": "$(eye)"
      },
      {
        "command": "freshFileExplorer.resurrect",
        "title": "Resurrect Deleted File",
        "icon": "$(history)"
      },
      {
        "command": "freshFileExplorer.discardChanges",
        "title": "Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "freshFileExplorer.createFileNextTo",
        "title": "New File Here",
        "icon": "$(new-file)"
      },
      {
        "command": "freshFileExplorer.createFileInside",
        "title": "New File Inside",
        "icon": "$(new-file)"
      },
      {
        "command": "freshFileExplorer.revealInSourceControl",
        "title": "Reveal in Source Control View"
      },
      {
        "command": "freshFileExplorer.filterByAuthor",
        "title": "Filter by Author",
        "icon": "$(person)"
      },
      {
        "command": "freshFileExplorer.filterByCommit",
        "title": "Filter by Commit",
        "icon": "$(git-commit)"
      },
      {
        "command": "freshFileExplorer.clearFilters",
        "title": "Clear Filters",
        "icon": "$(clear-all)"
      },
      {
        "command": "freshFileExplorer.toggleHeatmap",
        "title": "Toggle Heatmap Coloring",
        "icon": "$(color-mode)"
      },
      {
        "command": "freshFileExplorer.searchInFreshFiles",
        "title": "Search in Fresh Files",
        "icon": "$(search)"
      },
      {
        "command": "freshFileExplorer.openDiffSearchPanel",
        "title": "Open Diff Search",
        "icon": "$(search)"
      },
      {
        "command": "freshFileExplorer.openDiffMatch",
        "title": "Open Diff"
      },
      {
        "command": "freshFileExplorer.clearDiffSearch",
        "title": "Clear Diff Search Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "freshFileExplorer.gitLogFile",
        "title": "File History"
      },
      {
        "command": "freshFileExplorer.gitLogL",
        "title": "Line/Function History"
      },
      {
        "command": "freshFileExplorer.gitPickaxe",
        "title": "Search Diffs for Selection"
      },
      {
        "command": "freshFileExplorer.searchInFoundFiles",
        "title": "Search in Found Files",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "freshFileExplorer.openAllFoundFiles",
        "title": "Open All Found Files",
        "icon": "$(files)"
      },
      {
        "command": "freshFileExplorer.copyPathsFromSearchResults",
        "title": "Copy File Paths",
        "icon": "$(copy)"
      },
      {
        "command": "freshFileExplorer.quickPickFile",
        "title": "Fresh Files: Quick Open",
        "icon": "$(list-selection)"
      },
      {
        "command": "freshFileExplorer.pinFile",
        "title": "Pin File",
        "icon": "$(pin)"
      },
      {
        "command": "freshFileExplorer.unpinFile",
        "title": "Unpin File",
        "icon": "$(pinned)"
      },
      {
        "command": "freshFileExplorer.addNote",
        "title": "Add Note",
        "icon": "$(add)"
      },
      {
        "command": "freshFileExplorer.editNote",
        "title": "Edit Note",
        "icon": "$(edit)"
      },
      {
        "command": "freshFileExplorer.toggleNoteCompleted",
        "title": "Toggle Complete",
        "icon": "$(check)"
      },
      {
        "command": "freshFileExplorer.deleteNote",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "freshFileExplorer.clearAllPinned",
        "title": "Clear All Pinned Items",
        "icon": "$(clear-all)"
      },
      {
        "command": "freshFileExplorer.clearCompleted",
        "title": "Clear Completed",
        "icon": "$(checklist)"
      }
    ],
    "keybindings": [
      {
        "command": "freshFileExplorer.quickPickFile",
        "key": "ctrl+q f"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "freshFileExplorer.searchInFoundFiles",
          "when": "activeEditor == 'workbench.editor.searchEditor'",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.openAllFoundFiles",
          "when": "activeEditor == 'workbench.editor.searchEditor'",
          "group": "navigation@2"
        },
        {
          "command": "freshFileExplorer.copyPathsFromSearchResults",
          "when": "activeEditor == 'workbench.editor.searchEditor'",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "freshFileExplorer.gitLogL",
          "when": "editorHasSelection || editorTextFocus",
          "group": "z_freshfiles@1"
        },
        {
          "command": "freshFileExplorer.gitLogFile",
          "when": "editorTextFocus",
          "group": "z_freshfiles@2"
        },
        {
          "command": "freshFileExplorer.gitPickaxe",
          "when": "editorHasSelection || editorTextFocus",
          "group": "z_freshfiles@3"
        },
        {
          "command": "freshFileExplorer.searchInFoundFiles",
          "when": "inSearchEditor",
          "group": "1_search@10"
        },
        {
          "command": "freshFileExplorer.openAllFoundFiles",
          "when": "inSearchEditor",
          "group": "1_search@11"
        },
        {
          "command": "freshFileExplorer.copyPathsFromSearchResults",
          "when": "inSearchEditor",
          "group": "1_search@12"
        }
      ],
      "explorer/context": [
        {
          "command": "freshFileExplorer.pinFile",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@100"
        }
      ],
      "view/title": [
        {
          "command": "freshFileExplorer.toggleOpenMode",
          "when": "view == freshFileExplorer",
          "group": "navigation@0"
        },
        {
          "command": "freshFileExplorer.setTimeWindow",
          "when": "view == freshFileExplorer",
          "group": "navigation@2"
        },
        {
          "command": "freshFileExplorer.viewOptions",
          "when": "view == freshFileExplorer",
          "group": "navigation@2.5"
        },
        {
          "command": "freshFileExplorer.clearFilters",
          "when": "view == freshFileExplorer && freshFileExplorer.hasFilters",
          "group": "navigation@5"
        },
        {
          "command": "freshFileExplorer.refresh",
          "when": "view == freshFileExplorer",
          "group": "1_actions@1"
        },
        {
          "command": "freshFileExplorer.searchInFreshFiles",
          "when": "view == freshFileExplorer",
          "group": "1_actions@2"
        },
        {
          "command": "freshFileExplorer.openDiffSearchPanel",
          "when": "view == diffSearchResults",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.toggleHeatmap",
          "when": "view == freshFileExplorer",
          "group": "1_actions@3"
        },
        {
          "command": "freshFileExplorer.clearDiffSearch",
          "when": "view == diffSearchResults",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "freshFileExplorer.openFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.openChanges",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "navigation@1.5"
        },
        {
          "command": "freshFileExplorer.openToSide",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "navigation@2"
        },
        {
          "command": "freshFileExplorer.openCommit",
          "when": "view == freshFileExplorer && viewItem == file",
          "group": "navigation@2.5"
        },
        {
          "command": "freshFileExplorer.gitLogFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile)$/",
          "group": "navigation@2.6"
        },
        {
          "command": "freshFileExplorer.expandSubtree",
          "when": "view == freshFileExplorer && viewItem == folder",
          "group": "1_expand@1"
        },
        {
          "command": "freshFileExplorer.revealInExplorer",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|folder|deletedFile)$/",
          "group": "navigation@3"
        },
        {
          "command": "freshFileExplorer.revealInSourceControl",
          "when": "view == freshFileExplorer && viewItem == pendingFile",
          "group": "navigation@4"
        },
        {
          "command": "freshFileExplorer.discardChanges",
          "when": "view == freshFileExplorer && viewItem == pendingFile",
          "group": "2_modification@1"
        },
        {
          "command": "freshFileExplorer.createFileNextTo",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile|folder)$/",
          "group": "2_modification@2"
        },
        {
          "command": "freshFileExplorer.createFileInside",
          "when": "view == freshFileExplorer && viewItem =~ /^(folder|workspaceFolder|repoFolder)$/",
          "group": "2_modification@3"
        },
        {
          "command": "freshFileExplorer.resurrect",
          "when": "view == freshFileExplorer && viewItem == deletedFile",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.pinFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile)$/",
          "group": "9_pin@1"
        },
        {
          "command": "freshFileExplorer.unpinFile",
          "when": "view == freshFileExplorer && viewItem == pinnedFile",
          "group": "9_pin@1"
        },
        {
          "command": "freshFileExplorer.toggleNoteCompleted",
          "when": "view == freshFileExplorer && viewItem == pinnedNote",
          "group": "inline@1"
        },
        {
          "command": "freshFileExplorer.editNote",
          "when": "view == freshFileExplorer && viewItem == pinnedNote",
          "group": "inline@2"
        },
        {
          "command": "freshFileExplorer.deleteNote",
          "when": "view == freshFileExplorer && viewItem == pinnedNote",
          "group": "1_note@1"
        },
        {
          "command": "freshFileExplorer.addNote",
          "when": "view == freshFileExplorer && viewItem == pinnedFolder",
          "group": "inline@1"
        },
        {
          "command": "freshFileExplorer.clearCompleted",
          "when": "view == freshFileExplorer && viewItem == pinnedFolder",
          "group": "inline@2"
        },
        {
          "command": "freshFileExplorer.clearAllPinned",
          "when": "view == freshFileExplorer && viewItem == pinnedFolder",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "freshFileExplorer.refresh",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.expandAll",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.revealInExplorer",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.viewOptions",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.openFile",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.openToSide",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.exhume",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.resurrect",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.discardChanges",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.createFileNextTo",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.createFileInside",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.revealInSourceControl",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.pinFile",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.unpinFile",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.addNote",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.editNote",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.toggleNoteCompleted",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.deleteNote",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.clearAllPinned",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.clearCompleted",
          "when": "false"
        },
        {
          "command": "freshFileExplorer.openCommit",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "freshFileExplorer",
        "contents": "Loading fresh files...",
        "when": "freshFileExplorer.loading"
      }
    ],
    "colors": [
      {
        "id": "freshFileExplorer.heatmap.age1",
        "description": "Most recent files (heatmap) - brightest",
        "defaults": {
          "dark": "#00E5FF",
          "light": "#00ACC1",
          "highContrast": "#18FFFF",
          "highContrastLight": "#00838F"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age2",
        "description": "Very recent files (heatmap)",
        "defaults": {
          "dark": "#26C6DA",
          "light": "#0097A7",
          "highContrast": "#40C4FF",
          "highContrastLight": "#006064"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age3",
        "description": "Recent files (heatmap)",
        "defaults": {
          "dark": "#29B6F6",
          "light": "#0288D1",
          "highContrast": "#448AFF",
          "highContrastLight": "#01579B"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age4",
        "description": "Moderately recent files (heatmap)",
        "defaults": {
          "dark": "#42A5F5",
          "light": "#1976D2",
          "highContrast": "#2196F3",
          "highContrastLight": "#0D47A1"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age5",
        "description": "Mid-age files (heatmap)",
        "defaults": {
          "dark": "#5C6BC0",
          "light": "#303F9F",
          "highContrast": "#536DFE",
          "highContrastLight": "#1A237E"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age6",
        "description": "Older files (heatmap)",
        "defaults": {
          "dark": "#78909C",
          "light": "#546E7A",
          "highContrast": "#90A4AE",
          "highContrastLight": "#37474F"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age7",
        "description": "Old files (heatmap)",
        "defaults": {
          "dark": "#90A4AE",
          "light": "#607D8B",
          "highContrast": "#B0BEC5",
          "highContrastLight": "#455A64"
        }
      },
      {
        "id": "freshFileExplorer.heatmap.age8",
        "description": "Oldest files (heatmap) - most faded",
        "defaults": {
          "dark": "#B0BEC5",
          "light": "#78909C",
          "highContrast": "#CFD8DC",
          "highContrastLight": "#546E7A"
        }
      }
    ],
    "configuration": {
      "title": "Fresh File Explorer",
      "properties": {
        "freshFileExplorer.description.showDate": {
          "type": "boolean",
          "default": true,
          "description": "Show relative date in file description"
        },
        "freshFileExplorer.description.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Show commit author in file description"
        },
        "freshFileExplorer.description.showCommitHash": {
          "type": "boolean",
          "default": false,
          "description": "Show commit hash in file description"
        },
        "freshFileExplorer.description.showCommitMessage": {
          "type": "boolean",
          "default": true,
          "description": "Show commit message in file description"
        },
        "freshFileExplorer.description.showStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show file status (modified, added, etc.)"
        },
        "freshFileExplorer.description.showLineChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show line additions/deletions (+/-) in file descriptions"
        },
        "freshFileExplorer.autoExpandDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of directory levels to automatically expand when the tree is loaded (0 = collapsed, 1 = root expanded, etc.)"
        },
        "freshFileExplorer.timeWindows": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "default": [
            1,
            3,
            7,
            14,
            30,
            60,
            90,
            180
          ],
          "description": "List of day values for time window options. 'Pending changes' is always available."
        },
        "freshFileExplorer.gitTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Timeout in seconds for git operations. I consider it suspicious if you ever need to increase this number. Please open an issue."
        },
        "freshFileExplorer.showCurrentBranchSync": {
          "type": "boolean",
          "default": true,
          "description": "Show sync status warnings for current branch (indicating you need to push/pull)"
        },
        "freshFileExplorer.showBaseBranchSync": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings when base branch has commits not in current branch (indicating you need to merge)"
        },
        "freshFileExplorer.searchPatternMaxLength": {
          "type": "number",
          "default": 4000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum length for search include pattern per batch. When exceeded, files are split into multiple search editor tabs."
        },
        "freshFileExplorer.openSearchInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open searches in a Search Editor tab instead of the Search view"
        },
        "freshFileExplorer.heatmap.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Color files by recency (heatmap). Recent files appear bright (cyan/blue), older files faded (gray). Colors appear in all views (Explorer, tabs, Fresh Files tree)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run compile:webview",
    "compile": "tsc -p ./ && npm run copy:fixtures",
    "compile:webview": "tsc -p tsconfig.webview.json --noEmit && esbuild src/webview/gitLogLPanel.ts src/webview/diffSearchPanel.ts --bundle --outdir=media --format=iife --platform=browser",
    "copy:fixtures": "copyfiles -u 1 \"src/test/fixtures/**\" out/",
    "watch": "run-p watch:ext watch:webview",
    "watch:ext": "tsc -watch -p ./",
    "watch:webview": "esbuild src/webview/gitLogLPanel.ts src/webview/diffSearchPanel.ts --bundle --outdir=media --format=iife --platform=browser --watch",
    "pretest": "npm run compile && npm run compile:webview && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:coverage": "vscode-test --coverage"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  }
}
