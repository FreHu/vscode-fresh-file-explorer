{
  "name": "fresh-file-explorer",
  "displayName": "Fresh File Explorer",
  "description": "Easily navigate recent changes based on your pending work and Git history.",
  "license": "MIT",
  "pricing": "Free",
  "publisher": "frehu",
  "sponsor": {
    "url": "https://github.com/sponsors/FreHu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FreHu/vscode-fresh-file-explorer"
  },
  "version": "1.9.0",
  "icon": "icons/extension.png",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file-explorer",
    "recent-files",
    "modified-files",
    "git",
    "git-history",
    "diff-search",
    "pickaxe",
    "git-log-l",
    "heatmap",
    "gitlens"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension runs Git commands and accesses the local filesystem, which requires a trusted workspace."
    }
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "freshFileExplorer",
          "name": "Fresh Files",
          "type": "tree",
          "icon": "icons/fresh-files.svg",
          "contextualTitle": "Fresh File Explorer",
          "group": "freshfileexplorer@1"
        },
        {
          "id": "pinnedItems",
          "name": "Pinned Items",
          "type": "tree",
          "icon": "icons/fresh-files.svg",
          "contextualTitle": "Fresh File Explorer",
          "group": "freshfileexplorer@2"
        },
        {
          "id": "diffSearchResults",
          "name": "Diff Search Results",
          "type": "tree",
          "icon": "$(git-compare)",
          "contextualTitle": "Diff Search Results",
          "when": "diffSearchResults.hasResults"
        }
      ]
    },
    "commands": [
      {
        "command": "freshFileExplorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "freshFileExplorer.setTimeWindow",
        "title": "Set Time Window",
        "icon": "$(calendar)"
      },
      {
        "command": "freshFileExplorer.viewOptions",
        "title": "View Options",
        "icon": "$(filter)"
      },
      {
        "command": "freshFileExplorer.setGroupingMode",
        "title": "Set Grouping Mode",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "freshFileExplorer.setSortOrder",
        "title": "Set Sort Order",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "freshFileExplorer.showOutput",
        "title": "Fresh Files: Show Output Log"
      },
      {
        "command": "freshFileExplorer.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "freshFileExplorer.expandSubtree",
        "title": "Expand Subtree"
      },
      {
        "command": "freshFileExplorer.revealInExplorer",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "freshFileExplorer.openFile",
        "title": "Open"
      },
      {
        "command": "freshFileExplorer.openChanges",
        "title": "Open Changes"
      },
      {
        "command": "freshFileExplorer.openCommit",
        "title": "Open Commit"
      },
      {
        "command": "freshFileExplorer.openCommitFromBlame",
        "title": "Open Commit (from Blame)"
      },
      {
        "command": "freshFileExplorer.restoreDeletedLinesAt",
        "title": "Restore from baseline"
      },
      {
        "command": "freshFileExplorer.copyDeletedLinesAt",
        "title": "Copy baseline lines"
      },
      {
        "command": "freshFileExplorer.blameDiffBaseline",
        "title": "Diff with Branch / Tag…"
      },
      {
        "command": "freshFileExplorer.blameDiffBaselineConfigured",
        "title": "Diff with saved baseline"
      },
      {
        "command": "freshFileExplorer.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "freshFileExplorer.toggleOpenMode",
        "title": "Toggle left click action between Open File / Compare with previous",
        "icon": "$(file)"
      },
      {
        "command": "freshFileExplorer.exhume",
        "title": "View Deleted File",
        "icon": "$(eye)"
      },
      {
        "command": "freshFileExplorer.resurrect",
        "title": "Resurrect Deleted File",
        "icon": "$(history)"
      },
      {
        "command": "freshFileExplorer.discardChanges",
        "title": "Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "freshFileExplorer.deleteFile",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "freshFileExplorer.renameFile",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "freshFileExplorer.createFileNextTo",
        "title": "New File Here",
        "icon": "$(new-file)"
      },
      {
        "command": "freshFileExplorer.createFileInside",
        "title": "New File Inside",
        "icon": "$(new-file)"
      },
      {
        "command": "freshFileExplorer.revealInSourceControl",
        "title": "Reveal in Source Control View"
      },
      {
        "command": "freshFileExplorer.filterByAuthor",
        "title": "Filter by Author",
        "icon": "$(person)"
      },
      {
        "command": "freshFileExplorer.filterByCommit",
        "title": "Filter by Commit",
        "icon": "$(git-commit)"
      },
      {
        "command": "freshFileExplorer.clearFilters",
        "title": "Clear Filters",
        "icon": "$(clear-all)"
      },
      {
        "command": "freshFileExplorer.toggleHeatmap",
        "title": "Toggle Heatmap Coloring",
        "icon": "$(color-mode)"
      },
      {
        "command": "freshFileExplorer.blameHeatmapPicker",
        "title": "Blame Heatmap",
        "icon": "$(color-mode)"
      },
      {
        "command": "freshFileExplorer.blameApplyAge",
        "title": "Age",
        "category": "Blame Heatmap"
      },
      {
        "command": "freshFileExplorer.blameApplyBranchSaved",
        "title": "Branch / Tag (saved baseline)",
        "category": "Blame Heatmap"
      },
      {
        "command": "freshFileExplorer.blamePickBranch",
        "title": "Pick branch / tag…",
        "category": "Blame Heatmap"
      },
      {
        "command": "freshFileExplorer.blameTurnOff",
        "title": "Turn off",
        "category": "Blame Heatmap"
      },
      {
        "command": "freshFileExplorer.blameClearBaseline",
        "title": "Clear saved baseline",
        "category": "Blame Heatmap"
      },
      {
        "command": "freshFileExplorer.blameToggleAutoApply",
        "title": "Toggle auto-apply",
        "category": "Blame Heatmap"
      },
      {
        "command": "freshFileExplorer.searchInFreshFiles",
        "title": "Search in Fresh Files",
        "icon": "$(search)"
      },
      {
        "command": "freshFileExplorer.openDiffSearchPanel",
        "title": "Open Diff Search",
        "icon": "$(search)"
      },
      {
        "command": "freshFileExplorer.openDiffMatch",
        "title": "Open Diff"
      },
      {
        "command": "freshFileExplorer.clearDiffSearch",
        "title": "Clear Diff Search Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "freshFileExplorer.gitLogFile",
        "title": "File History"
      },
      {
        "command": "freshFileExplorer.gitLogL",
        "title": "Line/Function History"
      },
      {
        "command": "freshFileExplorer.gitPickaxe",
        "title": "Search Diffs for Selection"
      },
      {
        "command": "freshFileExplorer.perfBenchmark",
        "title": "Open Git Performance Benchmark",
        "category": "Fresh File Explorer"
      },
      {
        "command": "freshFileExplorer.openStonksPanel",
        "title": "CodeStonks",
        "category": "Fresh File Explorer",
        "icon": "$(graph-line)"
      },
      {
        "command": "freshFileExplorer.copyFile",
        "title": "Copy"
      },
      {
        "command": "freshFileExplorer.cutFile",
        "title": "Cut"
      },
      {
        "command": "freshFileExplorer.pasteFile",
        "title": "Paste"
      },
      {
        "command": "freshFileExplorer.copyAbsolutePath",
        "title": "Copy Absolute Path"
      },
      {
        "command": "freshFileExplorer.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "freshFileExplorer.copyFilename",
        "title": "Copy Filename"
      },
      {
        "command": "freshFileExplorer.copySubtreeStructure",
        "title": "Copy Subtree Structure"
      },
      {
        "command": "freshFileExplorer.copyRemoteUrl",
        "title": "Copy Remote URL"
      },
      {
        "command": "freshFileExplorer.setRepoPathspec",
        "title": "Set Pathspec Filter"
      },
      {
        "command": "freshFileExplorer.scopeToFolder",
        "title": "Scope to This Folder"
      },
      {
        "command": "freshFileExplorer.clearFolderScope",
        "title": "Clear Folder Scope"
      },
      {
        "command": "freshFileExplorer.revealActiveFile",
        "title": "Reveal Active File in Fresh Files",
        "icon": "$(target)"
      },
      {
        "command": "freshFileExplorer.searchInFoundFiles",
        "title": "Search in Found Files",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "freshFileExplorer.openAllFoundFiles",
        "title": "Open All Found Files",
        "icon": "$(files)"
      },
      {
        "command": "freshFileExplorer.copyPathsFromSearchResults",
        "title": "Copy File Paths",
        "icon": "$(copy)"
      },
      {
        "command": "freshFileExplorer.quickPickFile",
        "title": "Fresh Files: Quick Open",
        "icon": "$(list-selection)"
      },
      {
        "command": "freshFileExplorer.pinFile",
        "title": "Pin File",
        "icon": "$(pin)"
      },
      {
        "command": "freshFileExplorer.unpinFile",
        "title": "Unpin File",
        "icon": "$(pinned)"
      },
      {
        "command": "freshFileExplorer.addNote",
        "title": "Add Note",
        "icon": "$(add)"
      },
      {
        "command": "freshFileExplorer.editNote",
        "title": "Edit Note",
        "icon": "$(edit)"
      },
      {
        "command": "freshFileExplorer.toggleNoteCompleted",
        "title": "Toggle Complete",
        "icon": "$(check)"
      },
      {
        "command": "freshFileExplorer.deleteNote",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "freshFileExplorer.clearAllPinned",
        "title": "Clear All Pinned Items",
        "icon": "$(clear-all)"
      },
      {
        "command": "freshFileExplorer.clearCompleted",
        "title": "Clear Completed",
        "icon": "$(checklist)"
      },
      {
        "command": "freshFileExplorer.focusSubmoduleRepo",
        "title": "Focus Submodule Repo",
        "when": "false"
      },
      {
        "command": "freshFileExplorer.compareSelected",
        "title": "Compare Selected",
        "icon": "$(git-compare)"
      }
    ],
    "keybindings": [
      {
        "command": "freshFileExplorer.quickPickFile",
        "key": "ctrl+q f"
      },
      {
        "command": "freshFileExplorer.deleteFile",
        "key": "Delete",
        "when": "focusedView == freshFileExplorer"
      },
      {
        "command": "freshFileExplorer.renameFile",
        "key": "F2",
        "when": "focusedView == freshFileExplorer"
      },
      {
        "command": "freshFileExplorer.copyFile",
        "key": "ctrl+c",
        "when": "focusedView == freshFileExplorer"
      },
      {
        "command": "freshFileExplorer.cutFile",
        "key": "ctrl+x",
        "when": "focusedView == freshFileExplorer"
      },
      {
        "command": "freshFileExplorer.pasteFile",
        "key": "ctrl+v",
        "when": "focusedView == freshFileExplorer && freshFileExplorer.hasClipboard"
      },
      {
        "command": "freshFileExplorer.compareSelected",
        "key": "ctrl+alt+c",
        "when": "focusedView == 'freshFileExplorer' || focusedView == 'pinnedItems'"
      }
    ],
    "submenus": [
      {
        "id": "freshFiles.blameHeatmap.gutter",
        "label": "Blame Heatmap"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "freshFileExplorer.searchInFoundFiles",
          "when": "activeEditor == 'workbench.editor.searchEditor'",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.openAllFoundFiles",
          "when": "activeEditor == 'workbench.editor.searchEditor'",
          "group": "navigation@2"
        },
        {
          "command": "freshFileExplorer.copyPathsFromSearchResults",
          "when": "activeEditor == 'workbench.editor.searchEditor'",
          "group": "navigation@3"
        }
      ],
      "editor/lineNumber/context": [
        {
          "submenu": "freshFiles.blameHeatmap.gutter",
          "when": "resourceScheme == file",
          "group": "z_freshfiles@0"
        },
        {
          "command": "freshFileExplorer.copyDeletedLinesAt",
          "when": "editorLineNumber in freshFiles.blameHeatmap.deletionLines",
          "group": "z_freshfiles@1"
        },
        {
          "command": "freshFileExplorer.restoreDeletedLinesAt",
          "when": "editorLineNumber in freshFiles.blameHeatmap.deletionLines",
          "group": "z_freshfiles@2"
        }
      ],
      "freshFiles.blameHeatmap.gutter": [
        {
          "command": "freshFileExplorer.blameApplyAge",
          "group": "1_modes@1"
        },
        {
          "command": "freshFileExplorer.blameApplyBranchSaved",
          "when": "freshFiles.blameHeatmap.hasBaseRef",
          "group": "1_modes@2"
        },
        {
          "command": "freshFileExplorer.blamePickBranch",
          "group": "1_modes@3"
        },
        {
          "command": "freshFileExplorer.blameTurnOff",
          "when": "freshFiles.blameHeatmap.active",
          "group": "1_modes@4"
        },
        {
          "command": "freshFileExplorer.blameDiffBaseline",
          "when": "!freshFiles.blameHeatmap.hasBaseRef",
          "group": "2_actions@1"
        },
        {
          "command": "freshFileExplorer.blameDiffBaselineConfigured",
          "when": "freshFiles.blameHeatmap.hasBaseRef",
          "group": "2_actions@1"
        },
        {
          "command": "freshFileExplorer.blameClearBaseline",
          "when": "freshFiles.blameHeatmap.hasBaseRef",
          "group": "2_actions@2"
        },
        {
          "command": "freshFileExplorer.blameToggleAutoApply",
          "group": "3_settings@1"
        }
      ],
      "editor/context": [
        {
          "command": "freshFileExplorer.gitLogL",
          "when": "editorHasSelection || editorTextFocus",
          "group": "z_freshfiles@1"
        },
        {
          "command": "freshFileExplorer.gitLogFile",
          "when": "editorTextFocus",
          "group": "z_freshfiles@2"
        },
        {
          "command": "freshFileExplorer.gitPickaxe",
          "when": "editorHasSelection || editorTextFocus",
          "group": "z_freshfiles@3"
        },
        {
          "command": "freshFileExplorer.blameDiffBaselineConfigured",
          "when": "editorTextFocus && resourceScheme == file && freshFiles.blameHeatmap.hasBaseRef",
          "group": "z_freshfiles@4"
        },
        {
          "command": "freshFileExplorer.blameDiffBaseline",
          "when": "editorTextFocus && resourceScheme == file && !freshFiles.blameHeatmap.hasBaseRef",
          "group": "z_freshfiles@4"
        },
        {
          "command": "freshFileExplorer.searchInFoundFiles",
          "when": "inSearchEditor",
          "group": "1_search@10"
        },
        {
          "command": "freshFileExplorer.openAllFoundFiles",
          "when": "inSearchEditor",
          "group": "1_search@11"
        },
        {
          "command": "freshFileExplorer.copyPathsFromSearchResults",
          "when": "inSearchEditor",
          "group": "1_search@12"
        }
      ],
      "explorer/context": [
        {
          "command": "freshFileExplorer.pinFile",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@100"
        },
        {
          "command": "freshFileExplorer.gitLogFile",
          "when": "!explorerResourceIsFolder && resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "z_freshfiles@1"
        },
        {
          "command": "freshFileExplorer.revealInSourceControl",
          "when": "!explorerResourceIsFolder && resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "z_freshfiles@2"
        },
        {
          "command": "freshFileExplorer.copyRemoteUrl",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "z_freshfiles@3"
        },
        {
          "command": "freshFileExplorer.copySubtreeStructure",
          "when": "explorerResourceIsFolder && resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "z_freshfiles@4"
        }
      ],
      "view/title": [
        {
          "command": "freshFileExplorer.toggleOpenMode",
          "when": "view == freshFileExplorer",
          "group": "navigation@0"
        },
        {
          "command": "freshFileExplorer.setTimeWindow",
          "when": "view == freshFileExplorer",
          "group": "navigation@2"
        },
        {
          "command": "freshFileExplorer.viewOptions",
          "when": "view == freshFileExplorer",
          "group": "navigation@2.5"
        },
        {
          "command": "freshFileExplorer.clearFilters",
          "when": "view == freshFileExplorer && freshFileExplorer.hasFilters",
          "group": "navigation@5"
        },
        {
          "command": "freshFileExplorer.refresh",
          "when": "view == freshFileExplorer",
          "group": "1_actions@1"
        },
        {
          "command": "freshFileExplorer.searchInFreshFiles",
          "when": "view == freshFileExplorer",
          "group": "1_actions@2"
        },
        {
          "command": "freshFileExplorer.openDiffSearchPanel",
          "when": "view == diffSearchResults",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.addNote",
          "when": "view == pinnedItems",
          "group": "navigation@1"
        },
        {
          "command": "freshFileExplorer.clearCompleted",
          "when": "view == pinnedItems",
          "group": "navigation@2"
        },
        {
          "command": "freshFileExplorer.clearAllPinned",
          "when": "view == pinnedItems",
          "group": "navigation@3"
        },
        {
          "command": "freshFileExplorer.revealActiveFile",
          "when": "view == freshFileExplorer",
          "group": "navigation@3"
        },
        {
          "command": "freshFileExplorer.toggleHeatmap",
          "when": "view == freshFileExplorer",
          "group": "1_actions@3"
        },
        {
          "command": "freshFileExplorer.openStonksPanel",
          "when": "view == freshFileExplorer",
          "group": "1_actions@4"
        },
        {
          "command": "freshFileExplorer.clearDiffSearch",
          "when": "view == diffSearchResults",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "freshFileExplorer.openFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "1_open@1"
        },
        {
          "command": "freshFileExplorer.openChanges",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "1_open@2"
        },
        {
          "command": "freshFileExplorer.openToSide",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "1_open@3"
        },
        {
          "command": "freshFileExplorer.openCommit",
          "when": "view == freshFileExplorer && viewItem == file",
          "group": "3_reveal@3"
        },
        {
          "command": "freshFileExplorer.gitLogFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile)$/",
          "group": "3_reveal@4"
        },
        {
          "command": "freshFileExplorer.expandSubtree",
          "when": "view == freshFileExplorer && viewItem =~ /^(folder|workspaceFolder|repoFolder)$/",
          "group": "1_expand@1"
        },
        {
          "command": "freshFileExplorer.revealInExplorer",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|folder|deletedFile)$/",
          "group": "3_reveal@1"
        },
        {
          "command": "freshFileExplorer.revealInSourceControl",
          "when": "view == freshFileExplorer && viewItem == pendingFile",
          "group": "3_reveal@2"
        },
        {
          "command": "freshFileExplorer.discardChanges",
          "when": "view == freshFileExplorer && viewItem == pendingFile",
          "group": "4_modification@6"
        },
        {
          "command": "freshFileExplorer.deleteFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "4_modification@7"
        },
        {
          "command": "freshFileExplorer.renameFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|folder)$/",
          "group": "4_modification@8"
        },
        {
          "command": "freshFileExplorer.copyFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|folder)$/",
          "group": "4_modification@4"
        },
        {
          "command": "freshFileExplorer.cutFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|folder)$/",
          "group": "4_modification@3"
        },
        {
          "command": "freshFileExplorer.pasteFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|folder|workspaceFolder|repoFolder)$/ && freshFileExplorer.hasClipboard",
          "group": "4_modification@5"
        },
        {
          "command": "freshFileExplorer.createFileNextTo",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile|folder)$/ && !freshFileExplorer.loading",
          "group": "4_modification@1"
        },
        {
          "command": "freshFileExplorer.createFileInside",
          "when": "view == freshFileExplorer && viewItem =~ /^(folder|workspaceFolder|repoFolder)$/ && !freshFileExplorer.loading",
          "group": "4_modification@2"
        },
        {
          "command": "freshFileExplorer.resurrect",
          "when": "view == freshFileExplorer && viewItem == deletedFile",
          "group": "1_open@1"
        },
        {
          "command": "freshFileExplorer.pinFile",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile)$/",
          "group": "2_pin@1"
        },
        {
          "command": "freshFileExplorer.copyAbsolutePath",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile|folder)$/",
          "group": "5_copypath@1"
        },
        {
          "command": "freshFileExplorer.copyRelativePath",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile|folder)$/",
          "group": "5_copypath@2"
        },
        {
          "command": "freshFileExplorer.copyFilename",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile|folder)$/",
          "group": "5_copypath@3"
        },
        {
          "command": "freshFileExplorer.copySubtreeStructure",
          "when": "view == freshFileExplorer && viewItem =~ /^(folder|workspaceFolder|repoFolder)$/",
          "group": "5_copypath@4"
        },
        {
          "command": "freshFileExplorer.copyRemoteUrl",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile|deletedFile|folder)$/",
          "group": "5_copypath@5"
        },
        {
          "command": "freshFileExplorer.setRepoPathspec",
          "when": "view == freshFileExplorer && viewItem =~ /^(workspaceFolder|repoFolder)$/",
          "group": "7_pathspec@1"
        },
        {
          "command": "freshFileExplorer.scopeToFolder",
          "when": "view == freshFileExplorer && viewItem == folder",
          "group": "1_expand@2"
        },
        {
          "command": "freshFileExplorer.clearFolderScope",
          "when": "view == freshFileExplorer && viewItem =~ /^(workspaceFolder|repoFolder)$/",
          "group": "7_pathspec@3"
        },
        {
          "command": "freshFileExplorer.unpinFile",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "2_pin@1"
        },
        {
          "command": "freshFileExplorer.openFile",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "1_open@1"
        },
        {
          "command": "freshFileExplorer.openChanges",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "1_open@2"
        },
        {
          "command": "freshFileExplorer.openToSide",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "1_open@3"
        },
        {
          "command": "freshFileExplorer.openCommit",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "3_reveal@3"
        },
        {
          "command": "freshFileExplorer.gitLogFile",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "3_reveal@4"
        },
        {
          "command": "freshFileExplorer.revealInExplorer",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "3_reveal@1"
        },
        {
          "command": "freshFileExplorer.revealInSourceControl",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "3_reveal@2"
        },
        {
          "command": "freshFileExplorer.copyAbsolutePath",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "5_copypath@1"
        },
        {
          "command": "freshFileExplorer.copyRelativePath",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "5_copypath@2"
        },
        {
          "command": "freshFileExplorer.copyFilename",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "5_copypath@3"
        },
        {
          "command": "freshFileExplorer.copyRemoteUrl",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "5_copypath@4"
        },
        {
          "command": "freshFileExplorer.toggleNoteCompleted",
          "when": "view == pinnedItems && viewItem == pinnedNote",
          "group": "inline@1"
        },
        {
          "command": "freshFileExplorer.editNote",
          "when": "view == pinnedItems && viewItem == pinnedNote",
          "group": "inline@2"
        },
        {
          "command": "freshFileExplorer.deleteNote",
          "when": "view == pinnedItems && viewItem == pinnedNote",
          "group": "1_note@1"
        },
        {
          "command": "freshFileExplorer.compareSelected",
          "when": "view == freshFileExplorer && viewItem =~ /^(file|pendingFile)$/",
          "group": "1_open@4"
        },
        {
          "command": "freshFileExplorer.compareSelected",
          "when": "view == pinnedItems && viewItem == pinnedFile",
          "group": "1_open@4"
        }
      ],
